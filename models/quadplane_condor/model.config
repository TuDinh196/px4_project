<?xml version="1.0"?>
<model>
  <name>Quadplane Condor</name>
  <version>1.0</version>
  <sdf version='1.10'>model.sdf</sdf>

  <author>
   <name>Condor UAV Project</name>
   <email>condor@uav.dev</email>
